# Все shell-скрипты и файлы, попадающие в Docker-образ, должны иметь LF-окончания.
# Иначе CRLF на Windows ломает shebang -> "exec /entrypoint.sh: no such file or directory".
*.sh    text eol=lf
Dockerfile text eol=lf
entrypoint.sh text eol=lf
*.lua     text eol=lf
*.py      text eol=lf
*.bat     text eol=crlf
